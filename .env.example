# Drexonyx V1 — environment variable reference
#
# SECURITY BOUNDARY RULE (DR 0103 §3.2):
#   Variables carrying credentials, API keys, secrets, HMAC secrets, or JWT
#   signing keys MUST NOT carry the NEXT_PUBLIC_ prefix and MUST NOT appear
#   in any client-side code path or browser-accessible bundle.
#   NEXT_PUBLIC_ variables are permitted ONLY for public base URLs, feature
#   flags with no security implication, and other non-sensitive client config.
#
# This file contains NO real credentials. Copy to .env.local for local dev.
# .env.local (and all other .env* files except this one) is gitignored and
# must never be committed to the repository.
#
# NODE_ENV is set automatically by Next.js (development / production) and
# must not be set manually.
#
# Deployment environment (development / staging / production) must be
# configured through the hosting platform's environment variable settings.

# ─── Authentication (Phase 05 — DR 0039) ──────────────────────────────────────
# NextAuth v5 JWT signing and encryption key.
# Required. Minimum 32 bytes of cryptographically random data.
# Generate: openssl rand -base64 32
# Server-side only. Never prefix with NEXT_PUBLIC_.
AUTH_SECRET=
# Base URL for NextAuth callbacks. Required on non-Vercel hosts.
# On Vercel with a custom domain, set explicitly to prevent NEXTAUTH_URL auto-detection issues.
# Example: https://portal.yourdomain.com
AUTH_URL=

# ─── Database (Phase 02) ───────────────────────────────────────────────────────
# PostgreSQL connection string — contains credentials; treat as a secret.
# Local dev: postgresql://drexonyx:drexonyx_dev@localhost:5432/drexonyx_v1
DATABASE_URL=

# ─── Stripe (Phase 05 — DR 0044/0045) ─────────────────────────────────────────
# Stripe API secret key. Server-side only. Never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_... prefix).
# Must match the secret configured in the Stripe Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# ─── Email — Resend (Phase 14 — DR 0099) ──────────────────────────────────────
# Resend API key (re_... prefix). Server-side only.
RESEND_API_KEY=
# Sender address for delivery emails. Format: Name <email@domain.com>
RESEND_FROM_ADDRESS=

# ─── Sales Outreach Safety Gate (Phase 5) ─────────────────────────────────────
# SAFETY-CRITICAL: When set to "true", ALL outreach and follow-up emails are
# redirected to the internal test recipient (Irenfold@gmail.com) instead of
# real prospects. This MUST be "true" during any testing or validation phase.
# Only set to "false" — or remove — after explicit human authorization confirming
# Resend domain verification, cron auth, and end-to-end test delivery.
# Absent or any value other than "true" means test mode is OFF and real prospect
# emails WILL be sent. Never leave this unset in a production deployment.
# Server-side only. Never prefix with NEXT_PUBLIC_.
SALES_OUTREACH_TEST_MODE=true

# ─── Higgsfield AI Provider (Phase 11 — DR 0077) ──────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
# V2 base URL: https://platform.higgsfield.ai
HIGGSFIELD_API_BASE_URL=
# Composite API key from the Higgsfield console: KEY_ID:KEY_SECRET (single value).
# Auth header sent: Authorization: Key {KEY_ID}:{KEY_SECRET}
HIGGSFIELD_API_KEY=
# Webhook: appended as ?hf_webhook={url} on every dispatch request.
# Must be a publicly reachable URL registered with Higgsfield for production.
HIGGSFIELD_WEBHOOK_URL=
HIGGSFIELD_WEBHOOK_SECRET=

# ─── Cloudflare R2 Object Storage (Phase 11 — DR 0081) ────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=

# ─── Skills AI (Phase 10) ──────────────────────────────────────────────────────
# Google Gemini API key (from Google AI Studio). Server-side only.
# Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Gemini model ID for skill invocations. Defaults to gemini-2.5-flash if unset.
# gemini-2.5-flash supports thinking/reasoning and JSON-mode. The adapter skips
# thought:true reasoning parts so only the final JSON response is returned.
# Example: gemini-2.5-flash
SKILLS_AI_MODEL=

# ─── Production Organization (Phase 19 — DR 0106) ────────────────────────────
# UUID of DREXONYX's production organization — the single data workspace.
# Required in staging and production for correct client portal session resolution.
# Absent in development: portal falls back to any active CLIENT membership.
# Server-side only. Never prefix with NEXT_PUBLIC_.
DREXONYX_ORG_ID=

# ─── Admin Deployment (Phase 24 — DR 0042) ────────────────────────────────────
# Set to "true" ONLY on the dedicated admin Vercel project.
# Leave unset on the public website — /admin/* and /api/admin/* return 404.
ENABLE_ADMIN_ROUTES=

# bcrypt hash of the operator passphrase used for admin login.
# Required on the admin deployment; must NOT be set on the public deployment.
# Generate: node -e "require('bcryptjs').hash('yourpassword', 12).then(h => console.log(h))"
# Store only the hash — never commit or log the plaintext passphrase.
# Server-side only. Never prefix with NEXT_PUBLIC_.
ADMIN_LOGIN_PASSWORD_HASH=

# Optional: dedicated HMAC secret for the admin session cookie.
# Falls back to AUTH_SECRET if unset. Generate: openssl rand -base64 32
# Server-side only. Never prefix with NEXT_PUBLIC_.
ADMIN_SESSION_SECRET=

# ─── Application (Phase 05 — DR 0099) ─────────────────────────────────────────
# Public base URL used to construct portal links in delivery emails.
# URL only — no credentials. Falls back to https://portal.example.com if absent.
NEXT_PUBLIC_BASE_URL=

# ─── WhatsApp Cloud API (DR 0125) ─────────────────────────────────────────────
# All three vars are server-side only. Never prefix with NEXT_PUBLIC_.
# Set in Vercel: Settings → Environment Variables → Production (server only).

# Token you choose; must match the Verify Token set in Meta App Dashboard.
# GET /api/webhooks/whatsapp uses this for the verification challenge.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# App Secret from Meta App Dashboard → Settings → Basic → App Secret.
# Required for HMAC-SHA256 signature verification on inbound webhooks.
WHATSAPP_APP_SECRET=

# Phone Number ID from Meta App Dashboard → WhatsApp → API Setup.
# Identifies which WhatsApp Business number routes to this organization.
WHATSAPP_PHONE_NUMBER_ID=

# ─── Facebook Graph API — Organic Publishing (DR 0126) ────────────────────────
# All server-side only. Never prefix with NEXT_PUBLIC_.

# System User Token from Meta Business Manager.
# Scoped to: pages_manage_posts, pages_read_engagement, pages_show_list.
# Must have access to BOTH pages below. System User Tokens do not expire.
META_PAGE_ACCESS_TOKEN=

# First authorized DREXONYX Facebook Page ID (numeric).
META_PAGE_ID_1=

# Second authorized DREXONYX Facebook Page ID (numeric).
META_PAGE_ID_2=

# ─── Ziina Payments (DR 0127) ──────────────────────────────────────────────────
# All server-side only. Never prefix with NEXT_PUBLIC_.

# Ziina API key from the Ziina dashboard.
ZIINA_API_KEY=

# Ziina API base URL. Default: https://api-v2.ziina.com
ZIINA_BASE_URL=

# Set to "false" to enable live payment processing. Any other value (or absent)
# means test mode. NEVER set to "false" in local dev; control via Vercel env only.
ZIINA_TEST_MODE=

# ─── Cron / Internal Jobs ──────────────────────────────────────────────────────
# Bearer token for /api/internal/* routes. Must match the Vercel Cron Bearer header.
# Generate: openssl rand -base64 32
# Server-side only. Never prefix with NEXT_PUBLIC_.
CRON_SECRET=

# ─── Production AI Configuration ──────────────────────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.

# Provider for AI generation jobs. Example: higgsfield
PRODUCTION_AI_PROVIDER=

# Model identifier passed to the AI provider. Example: hf_video_ultra
PRODUCTION_AI_MODEL=

# Prompt template for AI generation. May contain placeholders.
PRODUCTION_AI_PROMPT=

# ─── Automated QC Pipeline ─────────────────────────────────────────────────────
# Set to "false" to skip the file-existence check in automated QC (for staging only).
# Leave unset or set to "true" in production to enforce the check.
AUTOMATED_QC_REQUIRE_FILE=

# ─── Notifications / Alerts ────────────────────────────────────────────────────
# Email address to notify on admin events (delivery, approval, etc.).
ADMIN_NOTIFICATION_EMAIL=

# Email address to alert on orchestration errors (pipeline failures, etc.).
ORCHESTRATION_ALERT_EMAIL=

# ─── Internal Recovery ─────────────────────────────────────────────────────────
# Token required by /api/internal/run-recovery to authorize manual recovery runs.
# Generate: openssl rand -base64 32
# Server-side only. Never prefix with NEXT_PUBLIC_.
DREXONYX_RECOVERY_TOKEN=
