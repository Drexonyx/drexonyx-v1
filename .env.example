# Drexonyx V1 — environment variable convention
#
# This file documents the environment boundary convention. It contains
# NO real values and NO secrets. Copy it to .env.local for local
# development; .env.local (and every other .env* file except this one)
# is gitignored and must never be committed.
#
# Environment selection:
#   NODE_ENV is set automatically by Next.js (development / production)
#   and should not be set manually.
#
# Deployment environment (development / staging / production) should be
# configured through the hosting platform's environment variable settings,
# not through files committed to this repository.
#
# Frontend exposure rule:
#   Only variables prefixed with NEXT_PUBLIC_ are exposed to browser code.
#   Anything without that prefix stays server-side. Never prefix a secret
#   (API key, database credential, token) with NEXT_PUBLIC_.
#
# Database (Phase 02 — Database Foundation)
# PostgreSQL connection string. For local dev, run: docker compose up -d
# Then copy to .env.local with the local value shown below.
# Local value: postgresql://drexonyx:drexonyx_dev@localhost:5432/drexonyx_v1
DATABASE_URL=
